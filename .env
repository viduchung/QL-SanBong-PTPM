# =====================================================================================
# HỆ THỐNG QUẢN LÝ SÂN BÓNG ĐÁ (MICROSERVICES)
# FILE CẤU HÌNH TỔNG (.ENV) - CHỈNH SỬA TOÀN BỘ HỆ THỐNG TẠI ĐÂY
# =====================================================================================

# -------------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ QUẢN TRỊ CƠ SỞ DỮ LIỆU MYSQL
# -------------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

# Tên CSDL cho từng Microservice (Nguyên tắc Database-per-Service)
MYSQL_BOOKING_DB=football_booking_db
MYSQL_PAYMENT_DB=football_payment_db

# Cấu hình Hibernate JPA (update / validate / create-drop)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# -------------------------------------------------------------------------------------
# 2. CẤU HÌNH CỔNG CHẠY ỨNG DỤNG (SERVICE PORTS)
# -------------------------------------------------------------------------------------
BOOKING_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

# -------------------------------------------------------------------------------------
# 3. CẤU HÌNH GIAO TIẾP LIÊN DỊCH VỤ (SERVICE-TO-SERVICE COMMUNICATION)
# -------------------------------------------------------------------------------------
# URL để Payment Service và Notification Service gọi sang Booking Service
BOOKING_SERVICE_URL=http://localhost:8081

# Thời gian chờ kết nối và phản hồi (milliseconds)
BOOKING_SERVICE_CONNECT_TIMEOUT=2000
BOOKING_SERVICE_READ_TIMEOUT=3000

# -------------------------------------------------------------------------------------
# 4. CẤU HÌNH XÁC THỰC VÀ BẢO MẬT (BUỔI THỰC HÀNH 5 - JWT & SPRING SECURITY)
# -------------------------------------------------------------------------------------
JWT_SECRET=FootballBookingServiceSecretKeyForJwtAuthentication2026SecureLongString!@#$%^&*()
JWT_EXPIRATION_MS=86400000
INTERNAL_SERVICE_KEY=FootballInternalSecretServiceKey2026

